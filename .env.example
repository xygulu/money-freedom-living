# 部署模板：复制为 .env.local 并填入真实值（.env.local 不入库，.gitignore 必须覆盖 .env*）
#   cp .env.example .env.local

# ---- 应用 ----
# 邮件主题等处的应用名（可选，lib/auth.ts 里的 APP_NAME 兜底）
# APP_NAME=我的应用

# ---- 数据库（Neon Postgres）----
# 主连接串（pooled）。用 Neon CLI 一键写入：neon link --project-id <id> --branch <branch> -y
DATABASE_URL=<neon pooled 连接串>
# 备用 DB（可选）：DATABASE_URL_FALLBACK 未填时自动用 DATABASE_URL_UNPOOLED
#（neon link 会自动写入 UNPOOLED——同 project 直连，pooled 挂时可切，故障相关性高）
# DATABASE_URL_FALLBACK=<另一 Neon project 的连接串，真正异机容灾才填>
# DATABASE_URL_UNPOOLED=<Neon 直连连接串>
# DATABASE_URL_3=<第 3 备用连接串，可选>

# ---- Better Auth（服务端会话/密码）----
# openssl rand -base64 32 生成；⚠️ 更换后所有会话失效
BETTER_AUTH_SECRET=<至少 32 字符>
# 应用访问地址：本地 http://localhost:3000；部署必须设为真实域名，
# 否则认证端点 Origin 校验会 403。支付回跳 success_url 也用它。
BETTER_AUTH_URL=<应用基础 URL>

# ---- Google OAuth（社交登录；可选；不配则该 provider 不启用）----
# Google Cloud Console 创建 OAuth 客户端（Web 应用），
# 回调 URI 加 <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=<client_id>
GOOGLE_CLIENT_SECRET=<client_secret>

# ---- GitHub OAuth（社交登录；可选；不配则该 provider 不启用）----
# GitHub Settings > Developer settings > OAuth apps > New OAuth App
# 回调 URI 加 <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=<client_id>
GITHUB_CLIENT_SECRET=<client_secret>

# ---- Resend（邮件发送：验证邮箱 + 重置密码；可选；不配则两类邮件自动关闭）----
# 注册 resend.com 建 API Key。⚠️ 免费层未验证域名时只能发给 Resend 账户自身邮箱；
# 验证自有域名（DNS 加 Resend 给的记录）后才能发给任意收件人
RESEND_API_KEY=<re_xxx>
RESEND_FROM=<如 onboarding@resend.dev 或 noreply@yourdomain.com>

# ---- Creem（订阅支付，Merchant of Record；支付中立层的第一个 adapter）----
# 支付层是多平台通用的：接入新平台 = 新增 adapter + registry 注册一行 + 平台 env。
# 启用判定 fail-closed：API key 与 webhook secret 必须同时配置，缺一平台不启用。
#
# Dashboard > API Keys。creem_test_ 前缀自动走测试环境（test-api.creem.io），
# creem_ 前缀走生产（api.creem.io），代码无需改动
CREEM_API_KEY=<creem_test_xxx 测试 / creem_xxx 生产>
# 订阅产品 id（CLI 创建示例：creem products create --price 199 --currency USD
#   --billing-type recurring --billing-period every-month --tax-category saas）
CREEM_PRODUCT_ID=<prod_xxx>
# Webhook 签名密钥（Dashboard > Developers > Webhook 注册
# https://<域名>/api/payments/webhook 后获取；所有平台共用这一个端点）
CREEM_WEBHOOK_SECRET=<whsec_xxx>

# ---- LLM（Anthropic 兼容网关 + failover；移植自哄哄 llm-providers 模式）----
# 第 1 项：智谱 glm（Anthropic 兼容端点）。缺 ANTHROPIC_AUTH_TOKEN 时不启用
ANTHROPIC_AUTH_TOKEN=<智谱 API Key>
# 缺省 https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_BASE_URL=
# 缺省 glm-5.3-flash
# ANTHROPIC_MODEL=

# 第 2 项备用 provider（Anthropic 兼容网关；三项全填才入列）。
# 用途：Go/No-Go 盲测不达标时切换（技术方案 §1）；免费/VIP 模型分级备用
# LLM_PROVIDER_2_BASE_URL=
# LLM_PROVIDER_2_AUTH_TOKEN=
# LLM_PROVIDER_2_MODEL=

# ---- 恢复码盐（技术方案 §4；openssl rand -base64 32）----
# RECOVERY_PEPPER=

# 隐私政策「联系我们」展示邮箱（/privacy 四语页读取；生产 build 时需在环境中提供）
SUPPORT_EMAIL=<you@example.com>
